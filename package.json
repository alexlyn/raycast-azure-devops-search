{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "azure-devops-search",
  "title": "Azure DevOps Search",
  "description": "Search Azure DevOps for work items and queries",
  "icon": "command-icon.png",
  "author": "alexlyn",
  "categories": [
    "Developer Tools",
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "workitem",
      "title": "Search Work Items",
      "description": "Search Azure DevOps issues by ID, text, type and project",
      "mode": "view"
    },
    {
      "name": "query",
      "title": "Search Queries",
      "description": "Search Azure DevOps queries",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "domain",
      "type": "textfield",
      "required": true,
      "title": "Azure DevOps Domain",
      "description": "Your Azure DevOps domain (e.g. 'dev.azure.com/mycompany')"
    },
    {
      "name": "token",
      "type": "password",
      "required": true,
      "title": "Personal Access Token",
      "description": "Your Personal Access Token"
    },
    {
      "name": "project",
      "type": "textfield",
      "required": true,
      "title": "Default Project",
      "description": "Default project for query searches"
    },
    {
      "name": "showRecent",
      "type": "checkbox",
      "required": true,
      "default": true,
      "label": "Show recently updated work items",
      "description": "Show recently updated work items in the search results"
    },
    {
      "name": "icons",
      "type": "dropdown",
      "required": true,
      "title": "Query Icons",
      "description": "Icons to use for queries",
      "data": [
        {
          "title": "Solid",
          "value": "solid"
        },
        {
          "title": "Outline",
          "value": "outline"
        }
      ],
      "default": "solid"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.7.3",
    "axios": "^1.7.9",
    "azure-devops-node-api": "^11.1.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^9.39.5",
    "prettier": "^3.4.2",
    "react-devtools": "6.1.1",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "build": "ray build -e dist -o dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint"
  }
}
